{
  "name": "cosspp-global",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node --import tsx scripts/validate.ts && tsc --noEmit && vite build && node --import tsx scripts/audit-build.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run tests/core.test.ts tests/cloud-refresh.test.ts",
    "validate": "node --import tsx scripts/validate.ts",
    "coverage:data": "node --import tsx scripts/coverage.ts",
    "data:export": "node --import tsx scripts/csv.ts export",
    "data:import": "node --import tsx scripts/csv.ts import",
    "links:check": "node --import tsx scripts/check-links.ts",
    "refresh:validate": "node --import tsx scripts/cloud-refresh.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests vite.config.ts playwright.config.ts",
    "schema:generate": "node --import tsx scripts/generate-schema.ts"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.56.0",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@11.25.0"
}
